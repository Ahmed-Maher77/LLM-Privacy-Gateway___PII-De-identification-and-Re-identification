# Environment and secrets
.env
.env.*
!.env.example

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/

# Local model and tool caches
.cache/
.huggingface/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Run artefacts. These may contain real PII and must never be committed.
# Written as reports/* plus a negation rather than reports/, so that
# reports/.gitignore can itself be tracked: git cannot re-include a file whose
# parent directory is excluded outright. That nested file is the belt-and-
# braces guard -- deleting this rule alone does not un-quarantine the directory.
reports/*
!reports/.gitignore
!reports/benchmark.json
!reports/benchmark.md
# Test-data audit artefacts may contain source text or incompletely redacted PII.
artifacts/
*__sanitized-input.txt
.pii-triage.json

# Working copies and ad-hoc transcripts under test_data/.
# The scored corpus lives in tests/fixtures/ and is tracked deliberately -- every
# fixture there is synthetic. test_data/ contains unredacted local working copies,
# ad-hoc tests, and real transcripts that must never be pushed to a repository.
test_data/*
!test_data/pod_meeting.txt
!test_data/sme_meeting_transcript.txt
scratch/

# Agent and editor local state / internal handoffs
.claude/settings.local.json
docs/antigravity-*.md

# Local pattern overrides
pii_patterns.toml
.pii-patterns.toml
# Documentation ignored from tracking
docs/

# Dependencies
node_modules/

# Environment configuration — never commit real secrets
.env
.env.*
!.env.example

# TypeScript build output
dist/

# Compiled test artifacts (tsx runs tests directly; compiled outputs not needed)
test/**/*.js
test/**/*.d.ts
test/**/*.map

# Generated pipeline reports & sanitized outputs (runtime artifacts, not source)
reports/

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*

# System & editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local/confidential test transcripts — real internal meeting recordings
test_data/test_*.txt
!test_data/test_result.txt

# Duplicate backup files
test_data/*copy*.txt
# Dependencies
node_modules/

# Temp files
*.tmp

# Environment configuration — never commit real secrets
.env
.env.*

# TypeScript build output
dist/

# Compiled test artifacts (tsx runs tests directly; compiled outputs not needed)
test/**/*.js
test/**/*.d.ts
test/**/*.map

# Generated pipeline reports & sanitized outputs (runtime artifacts, not source)
reports/

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*

# System & editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local test inputs (not tracked)
test_data/test_*.txt

# Duplicate backup files
test_data/*copy*.txt
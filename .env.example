# Privacy gateway configuration.
#
# Every value below is the built-in default, so an empty .env is a safe .env.
# Copy to .env and change only what you need. Never commit .env.

# ---------------------------------------------------------------------------
# Failure behaviour
# ---------------------------------------------------------------------------
# closed: abort rather than run under weaker protection than configured.
# open:   continue with a degraded status and a warning.
# Note that the pre-send leak gate and the aggregation invariants abort in BOTH
# modes -- there is no failing open on a transmission that already happened.
GATEWAY_FAIL_MODE=closed

# ---------------------------------------------------------------------------
# Detection
# ---------------------------------------------------------------------------
# An empty list is refused at startup: a gateway with no detectors would
# forward every document unprotected while reporting success.
GATEWAY_DETECTORS_ENABLED=regex,registry,domain,presidio,ner
GATEWAY_DETECTORS_REQUIRED=regex,registry

GATEWAY_PRESIDIO_SPACY_MODEL=en_core_web_lg
GATEWAY_PRESIDIO_THRESHOLD=0.35
GATEWAY_NER_MODEL=dslim/bert-base-NER
GATEWAY_NER_DEVICE=cpu
GATEWAY_NER_THRESHOLD=0.60
GATEWAY_DOMAIN_LEXICON=config/domain_lexicon.toml

# ---------------------------------------------------------------------------
# Qwen semantic layer (off by default)
# ---------------------------------------------------------------------------
# Requires: ollama pull qwen2.5:7b-instruct
# Its absence IS the configured protection level, which is why a Qwen failure
# is never fatal unless you set GATEWAY_QWEN_REQUIRED=true.
GATEWAY_QWEN_ENABLED=false
GATEWAY_QWEN_REQUIRED=false
GATEWAY_QWEN_MODEL=qwen2.5:7b-instruct
# GATEWAY_QWEN_BASE_URL=http://localhost:11434
GATEWAY_QWEN_TIMEOUT=60
GATEWAY_QWEN_MAX_CHARS=4000
GATEWAY_QWEN_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Downstream model
# ---------------------------------------------------------------------------
GATEWAY_LLM_PROVIDER=ollama
GATEWAY_OLLAMA_MODEL=gpt-oss:120b-cloud
# GATEWAY_OLLAMA_BASE_URL=http://localhost:11434
GATEWAY_LLM_TEMPERATURE=0.0
GATEWAY_LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# Placeholders and restoration
# ---------------------------------------------------------------------------
# angle:     <PERSON_001>   (the specified format)
# guillemet: [[PERSON_001]] style using U+27E6/27E7 -- no markdown or HTML
#            meaning, so a model is far less likely to mangle it
# bracket:   [[PERSON_001]]
GATEWAY_PLACEHOLDER_STYLE=angle
GATEWAY_PLACEHOLDER_PAD=3

# What to do with a well-formed placeholder that is not in this conversation's
# mapping. redact | keep
GATEWAY_REID_UNKNOWN_ACTION=redact
GATEWAY_SCAN_OUTPUT=true
GATEWAY_ON_DRIFT=retry
GATEWAY_MAX_DRIFT_RETRIES=1

GATEWAY_BLOCK_ON_INJECTION=true

# ---------------------------------------------------------------------------
# Limits and preprocessing
# ---------------------------------------------------------------------------
GATEWAY_MAX_INPUT_CHARS=1000000
# NFC, NFKC or none. NFKC is aggressive and buys nothing here; what actually
# matters (non-breaking spaces, smart quotes) is folded at zero offset cost.
GATEWAY_UNICODE_FORM=NFC
GATEWAY_DECODE_HTML_ENTITIES=true
GATEWAY_STRIP_ZERO_WIDTH=true

# ---------------------------------------------------------------------------
# Policy data
# ---------------------------------------------------------------------------
# Optional; missing file = built-in defaults from policy/actions.py
GATEWAY_POLICY_FILE=config/policy.toml
GATEWAY_ALLOWLIST_FILE=resources/public_entities.txt
GATEWAY_DENYLIST_FILE=resources/denylist.txt

# ---------------------------------------------------------------------------
# Artifacts
# ---------------------------------------------------------------------------
GATEWAY_ARTIFACTS_DIR=artifacts

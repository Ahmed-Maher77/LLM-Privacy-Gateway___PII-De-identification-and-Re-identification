# Hugging Face token for accessing models without rate limits
# HF_TOKEN=hf_xxx

# PyTorch intra-op threads per worker, read by PIIMiddleware.for_production() (default: half the logical CPUs, minimum 1)
# PII_TORCH_THREADS=4

# Custom patterns configuration file path (optional)
# PII_PATTERNS_CONFIG=pii_patterns.toml
